{
  "protocol_version": "controlled-aasce-geometry-coordinate-stem-standardized-v2",
  "dataset": {
    "outer_split": {
      "mode": "fixed_image_level",
      "split_seed": 42,
      "sizes": {"train": 336, "val": 72, "test": 73},
      "patient_ids_available": false
    },
    "landmark_inputs": {
      "train": "outputs/benchmarks/aasce_landmark_oof/seed_{detector_seed}/train_oof_predictions.npz",
      "val": "outputs/benchmarks/aasce_landmark_oof/seed_{detector_seed}/val_predictions.npz",
      "test": "outputs/benchmarks/aasce_landmark_oof/seed_{detector_seed}/test_predictions.npz"
    },
    "train_prediction_policy": "five-fold image OOF within the frozen 336-image training split",
    "val_test_prediction_policy": "full-train AASCE-HIH-68 checkpoint selected only by validation landmark error",
    "geometry_policy": "predicted L68 -> deterministic Auto-EV selector -> selected L8",
    "target_mode": "single_primary_cobb",
    "target_order": ["Cobb"]
  },
  "seeds": [17, 42, 73],
  "seed_protocol": {
    "default": "paired_detector_downstream",
    "pairs": [
      {"detector_seed": 17, "downstream_seed": 17},
      {"detector_seed": 42, "downstream_seed": 42},
      {"detector_seed": 73, "downstream_seed": 73}
    ]
  },
  "models": ["coordmlp", "deepsets_role_coordstem", "gnn_role_coordstem", "gae"],
  "batch_size": 16,
  "num_workers": 4,
  "amp": true,
  "max_epochs": 60,
  "patience": 20,
  "optimizer": "AdamW",
  "scheduler": "CosineAnnealingLR",
  "coordinate_input_stem": {
    "scope": ["deepsets_role_coordstem", "gnn_role_coordstem"],
    "geometry_normalization": "per-image centroid subtraction and isotropic RMS-radius scaling",
    "identity_conditioning": "separate 64-d coordinate and 64-d learned corner-role branches followed by 64-d fusion",
    "readout": "fixed-order role concatenation",
    "angle_preservation": true
  },
  "target_standardization": {
    "enabled": true,
    "source": "training OOF targets only",
    "ddof": 1,
    "inverse_transform_before_validation_and_test_metrics": true
  },
  "loss": {
    "name": "HuberLoss",
    "delta": 1.0,
    "units": "training-target standard deviations",
    "reduction": "mean"
  },
  "gradient_clip_norm": 1.0,
  "checkpoint_selection": "validation Cobb MAE in degrees only",
  "search_space": [
    {"lr": 0.0001, "weight_decay": 0.0},
    {"lr": 0.0001, "weight_decay": 0.00001},
    {"lr": 0.0001, "weight_decay": 0.0001},
    {"lr": 0.0003, "weight_decay": 0.0},
    {"lr": 0.0003, "weight_decay": 0.00001},
    {"lr": 0.0003, "weight_decay": 0.0001},
    {"lr": 0.001, "weight_decay": 0.0},
    {"lr": 0.001, "weight_decay": 0.00001},
    {"lr": 0.001, "weight_decay": 0.0001}
  ],
  "metrics": {
    "primary": "MAE",
    "agreement": "ICC(2,1)",
    "tolerance_deg": {"Cobb": 5.0},
    "additional": ["bias", "95% LoA", "prediction mean", "prediction SD"]
  }
}
